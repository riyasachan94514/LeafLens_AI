# Virtual environment
.venv/

# Datasets are downloaded from the Hub by prepare_data.py; never commit them.
data/

# Model weights and cached predictions are large binaries. The JSON metrics and
# PNG figures in results/ ARE committed, since those are the reported findings.
*.pt
*.npz

# Scratch runs (smoke tests, figure experiments).
results/_*

__pycache__/
*.py[cod]
.ipynb_checkpoints/
# Local prediction artifacts can contain machine-specific paths
results/*/plantdoc_predictions.npz
results/*/test_predictions.pt
results/*/*_predictions.json
results/*/abstention/*_predictions.json

# Local environments and editor/tool state
.freebuff/